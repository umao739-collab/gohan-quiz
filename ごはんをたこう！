<title>ごはんをたこう！クイズ</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap">
<style>
/* layout: 左に動画の写真、右に問題の2カラム。スマホでは縦に積む。いちばん上に10この道すじ（しんちょく）。 */
:root{
  --font:"Zen Maru Gothic","Hiragino Maru Gothic ProN","Yu Gothic UI","Meiryo",sans-serif;
  --bg:#E4F3EE; --card:#FFFFFF; --ink:#3B3248; --ink2:#6B617C; --line:#CDE4DC;
  --coral:#FF7A68; --coral-d:#E4604E; --sun:#FFC94D; --leaf:#3FB68B; --leaf-bg:#D8F3E7;
  --sky:#7CC3EC; --blush:#FFD3CC; --oops:#D9503F; --oops-bg:#FFE7E2;
  --on-sun:#3B3248; --on-coral:#3B3248; --on-leaf:#0F3B2C;
  --illu:#FFF4D6; --glass:rgba(255,255,255,.62); --glass-line:#7D90A8; --water:#BFE6F8;
  --bowl:#D8E7F4; --rice:#FFFFFF; --rice-dry:#EAE3D7; --rice-line:#B8AE9F; --cooked:#F4EEE4; --hole:#D6CDBE;
  --flame1:#FF8A3D; --flame2:#FFD34D; --steam-c:#B5C9D6; --pot:#B4BCC8; --stove:#8A8397; --wood:#D9A86B; --mitt:#FF9DB0;
  --bubble:rgba(255,255,255,.8); --tape:rgba(255,201,77,.78);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#241F2E; --card:#302A3F; --ink:#F6EFF4; --ink2:#C6BAD0; --line:#473F59;
    --coral:#FF9282; --coral-d:#E0705F; --sun:#FFD36E; --leaf:#5FD0A4; --leaf-bg:#244A40;
    --sky:#86C8EE; --blush:#4B3441; --oops:#FF9A8A; --oops-bg:#4E3138;
    --illu:#3B3550; --glass:rgba(255,255,255,.14); --glass-line:#AAB7CA; --water:#4F7E9A;
    --bowl:#58708B; --rice-dry:#CFC8BC; --rice-line:#8A8094; --cooked:#E9E2D6; --hole:#B9B0A2;
    --steam-c:#E5DBF0; --pot:#7B8495; --stove:#6C657A; --wood:#C9945A; --mitt:#F08AA0; --bubble:rgba(255,255,255,.35); --tape:rgba(255,211,110,.6);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#241F2E; --card:#302A3F; --ink:#F6EFF4; --ink2:#C6BAD0; --line:#473F59;
  --coral:#FF9282; --coral-d:#E0705F; --sun:#FFD36E; --leaf:#5FD0A4; --leaf-bg:#244A40;
  --sky:#86C8EE; --blush:#4B3441; --oops:#FF9A8A; --oops-bg:#4E3138;
  --illu:#3B3550; --glass:rgba(255,255,255,.14); --glass-line:#AAB7CA; --water:#4F7E9A;
  --bowl:#58708B; --rice-dry:#CFC8BC; --rice-line:#8A8094; --cooked:#E9E2D6; --hole:#B9B0A2;
  --steam-c:#E5DBF0; --pot:#7B8495; --stove:#6C657A; --wood:#C9945A; --mitt:#F08AA0; --bubble:rgba(255,255,255,.35); --tape:rgba(255,211,110,.6);
  color-scheme:dark;
}

*{box-sizing:border-box}
body{
  background:var(--bg); color:var(--ink); font-family:var(--font); font-weight:500; line-height:1.7;
  padding-block:18px 36px;
  padding-left:max(16px, env(safe-area-inset-left, 0px));
  padding-right:max(16px, env(safe-area-inset-right, 0px));
}
.app{max-width:1060px;margin:0 auto}
button{font-family:inherit}
ruby rt{font-size:.5em;font-weight:700}

/* header */
.top{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.top h1{margin:0;font-size:clamp(24px,4.2vw,34px);line-height:1.2;font-weight:900;letter-spacing:.02em}
.top .sub{margin:2px 0 0;color:var(--ink2);font-size:14px;font-weight:700}
.pre{margin-left:auto;font-size:12px;font-weight:900;color:var(--on-sun);background:var(--sun);border-radius:999px;padding:3px 12px}

/* progress (10 steps) */
.track{display:flex;align-items:center;list-style:none;margin:18px 0 0;padding:0}
.track li{flex:1;display:flex;align-items:center;min-width:0}
.track li:last-child{flex:none}
.dot{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-size:13px;font-weight:900;color:var(--ink2);background:var(--card);border:3px solid var(--line);transition:transform .2s}
.bar{flex:1;height:5px;border-radius:3px;background:var(--line);margin:0 4px;min-width:3px}
.bar.done{background:var(--leaf)}
.track .done .dot{background:var(--leaf);border-color:var(--leaf);color:var(--on-leaf)}
.track .now .dot{background:var(--sun);border-color:var(--sun);color:var(--on-sun);transform:scale(1.2)}
.dot svg{width:16px;height:16px}
@media (max-width:520px){
  .dot{width:23px;height:23px;font-size:11px;border-width:2px}
  .dot svg{width:13px;height:13px}
  .bar{margin:0 2px}
}

/* stage */
.stage{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:28px;align-items:start;margin-top:22px}
@media (max-width:780px){.stage{grid-template-columns:minmax(0,1fr);gap:18px}}
.pic{background:var(--illu);border-radius:32px;padding:22px 20px 14px}
.pic svg{display:block;width:100%;height:auto;max-width:100%}
.ph{margin:6px 6px 0;font-size:12px;font-weight:700;color:var(--ink2)}

/* polaroid photo */
.polaroid{position:relative;margin:0;background:var(--card);padding:10px 10px 0;border-radius:12px;box-shadow:0 6px 0 var(--line);transform:rotate(-1.1deg);max-width:100%}
.polaroid::before{content:"";position:absolute;left:50%;top:-12px;width:92px;height:24px;transform:translateX(-50%) rotate(2deg);background:var(--tape);border-radius:3px;opacity:.95}
.shot{display:block;width:100%;height:auto;max-width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:6px;background:var(--line)}
.cap{min-height:56px;display:flex;align-items:center;justify-content:center;padding:6px 8px 8px;font-size:18px;font-weight:900;text-align:center;line-height:1.4}
.cap.empty{color:var(--ink2);font-size:14px;font-weight:700}
.cap.pop{animation:pop .35s}
.qmeta{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.stagechip{background:var(--sun);color:var(--on-sun);font-weight:900;border-radius:999px;padding:3px 14px;font-size:14px}
.qno{font-size:14px;font-weight:900;color:var(--ink2)}
h2.q{margin:10px 0 6px;font-size:clamp(20px,2.7vw,26px);line-height:1.55;font-weight:900;text-wrap:balance;word-break:keep-all;overflow-wrap:anywhere;outline:none}
.choices{display:grid;gap:12px;margin-top:14px}
.choice{display:flex;align-items:center;gap:14px;width:100%;text-align:left;min-height:62px;padding:12px 16px;
  font-size:18px;font-weight:700;line-height:1.5;color:var(--ink);background:var(--card);
  border:3px solid var(--line);border-radius:22px;box-shadow:0 4px 0 var(--line);cursor:pointer;
  transition:transform .12s,border-color .12s,background .12s,box-shadow .12s}
.choice:hover:not([disabled]){border-color:var(--sky)}
.choice:active:not([disabled]){transform:translateY(3px);box-shadow:0 1px 0 var(--line)}
.choice[disabled]{cursor:default}
.badge{flex:none;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--sun);color:var(--on-sun);font-weight:900;font-size:16px}
.ctext{min-width:0;word-break:keep-all;overflow-wrap:anywhere}
.mark{margin-left:auto;flex:none;width:30px;height:30px;display:none}
.choice.good{background:var(--leaf-bg);border-color:var(--leaf);box-shadow:0 4px 0 var(--leaf)}
.choice.bad{background:var(--oops-bg);border-color:var(--oops);box-shadow:none;animation:shake .4s}
.choice.good .mark,.choice.bad .mark{display:block}
.choice.good .mark{color:var(--leaf)} .choice.bad .mark{color:var(--oops)}

/* feedback */
.fb{display:flex;gap:12px;align-items:flex-start;margin-top:18px;animation:pop .3s}
.fb>svg{flex:none;width:68px;height:auto}
.say{position:relative;flex:1;min-width:0;padding:12px 16px;border-radius:22px;border:3px solid var(--line);background:var(--card);font-weight:700;line-height:1.65}
.say::before{content:"";position:absolute;left:-10px;top:24px;width:15px;height:15px;transform:rotate(45deg);background:var(--card);border-left:3px solid var(--line);border-bottom:3px solid var(--line)}
.say strong{display:block;font-size:19px;font-weight:900}
.fb.ok .say{background:var(--leaf-bg);border-color:var(--leaf)}
.fb.ok .say::before{background:var(--leaf-bg);border-color:var(--leaf)}
.fb.no .say{background:var(--oops-bg);border-color:var(--oops)}
.fb.no .say::before{background:var(--oops-bg);border-color:var(--oops)}
.next{display:inline-flex;align-items:center;gap:8px;margin-top:16px;padding:12px 28px;font-size:19px;font-weight:900;color:var(--on-coral);background:var(--coral);border:0;border-radius:999px;box-shadow:0 5px 0 var(--coral-d);cursor:pointer;transition:transform .12s,box-shadow .12s}
.next:active{transform:translateY(4px);box-shadow:0 1px 0 var(--coral-d)}
.next svg{width:20px;height:20px}
:focus-visible{outline:4px solid var(--sky);outline-offset:3px;border-radius:12px}

/* result */
.hero{display:flex;flex-direction:column;align-items:flex-start;gap:6px;padding:22px}
.hero>svg{width:120px;height:auto}
.hero h2{margin:6px 0 0;font-size:26px;font-weight:900;line-height:1.4}
.hero p{margin:0;font-weight:700;color:var(--ink2)}
.stars{display:flex;flex-wrap:wrap;gap:4px;margin:6px 0 2px}
.stars svg{width:24px;height:24px}
.stars .off{opacity:.28}
.sheet{background:var(--card);border:3px solid var(--line);border-radius:28px;padding:16px 18px 10px}
.sheet h3{margin:0 0 4px;font-size:20px;font-weight:900}
.sheet .note{margin:0 0 10px;font-size:13px;color:var(--ink2);font-weight:700}
.row{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:12px;align-items:center;padding:10px 0;border-top:2px dashed var(--line)}
.row .ri{width:40px;height:40px}
.row .ri svg{width:100%;height:100%;display:block}
.row b{font-size:17px;font-weight:900}
.row .rt{font-size:13px;color:var(--ink2);font-weight:700;margin-left:8px}
.row .cue{display:block;font-size:15px;line-height:1.55;font-weight:700}
.tag{font-size:12px;font-weight:900;border-radius:999px;padding:3px 10px;white-space:nowrap}
.tag.on{background:var(--leaf-bg);color:var(--ink);border:2px solid var(--leaf)}
.tag.off{background:var(--illu);color:var(--ink2);border:2px dashed var(--line)}
@media (max-width:520px){.row{grid-template-columns:40px minmax(0,1fr)}.row .tag{grid-column:2;justify-self:start}}
.again{margin-top:10px;padding:10px 22px;font-size:16px;font-weight:900;color:var(--ink);background:var(--card);border:3px solid var(--line);border-radius:999px;box-shadow:0 4px 0 var(--line);cursor:pointer}
.foot{margin:26px 0 0;font-size:12px;color:var(--ink2);font-weight:700}

/* svg parts (theme-aware through tokens) */
.s-glass{fill:var(--glass);stroke:var(--glass-line);stroke-width:3;stroke-linejoin:round}
.s-water{fill:var(--water)} .s-water-o{fill:var(--water);stroke:var(--glass-line);stroke-width:2}
.s-rice{fill:var(--rice);stroke:var(--rice-line);stroke-width:.8}
.s-ricedry{fill:var(--rice-dry);stroke:var(--rice-line);stroke-width:.8}
.s-cooked{fill:var(--cooked)} .s-hole{fill:var(--hole)}
.s-pot{fill:var(--pot)} .s-stove{fill:var(--stove)} .s-stove2{fill:var(--stove);opacity:.8}
.s-flame1{fill:var(--flame1)} .s-flame2{fill:var(--flame2)}
.s-steam{fill:none;stroke:var(--steam-c);stroke-width:6;stroke-linecap:round}
.s-bowl{fill:var(--bowl);stroke:var(--glass-line);stroke-width:3;stroke-linejoin:round}
.s-shadow{fill:var(--ink);opacity:.08}
.s-swirl{fill:none;stroke:var(--glass-line);stroke-width:3;stroke-linecap:round;opacity:.7}
.s-sticker{fill:var(--sun)} .s-stxt{font-family:var(--font);font-size:15px;font-weight:900;fill:var(--on-sun);text-anchor:middle}
.s-clock{fill:var(--card);stroke:var(--glass-line);stroke-width:4} .s-hand{fill:none;stroke:var(--ink);stroke-width:4;stroke-linecap:round}
.s-q{font-family:var(--font);font-size:40px;font-weight:900;fill:var(--coral);text-anchor:middle}
.s-arrow{fill:none;stroke:var(--ink2);stroke-width:5;stroke-linecap:round;stroke-linejoin:round}
.s-outline{stroke:var(--glass-line);stroke-width:2.4;stroke-linejoin:round}
.s-leaf{fill:var(--leaf)}

/* motion */
.steam{animation:rise 2.8s ease-in-out infinite}
.flick{transform-box:fill-box;transform-origin:50% 100%;animation:flick .8s ease-in-out infinite alternate}
@keyframes rise{0%{opacity:0;transform:translateY(8px)}35%{opacity:1}100%{opacity:0;transform:translateY(-10px)}}
@keyframes flick{from{transform:scaleY(1)}to{transform:scaleY(.84) scaleX(1.06)}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@keyframes pop{from{transform:scale(.94);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes hop{0%,100%{transform:translateY(0)}40%{transform:translateY(-10px)}}
.fb.ok>svg{animation:hop .6s ease-out}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>

<div class="app" id="app"></div>

<script>
/* ---------- helpers ---------- */
var $=function(s){return document.querySelector(s)};
var rubyfy=function(t){return t.replace(/\{([^|}]+)\|([^}]+)\}/g,'<ruby>$1<rt>$2</rt></ruby>')};
function rnd(seed){var s=seed;return function(){s=(s*9301+49297)%233280;return s/233280}}
function grains(n,x0,y0,x1,y1,seed,cls,sz){
  var r=rnd(seed),o='';
  for(var k=0;k<n;k++){
    var x=(x0+r()*(x1-x0)).toFixed(1),y=(y0+r()*(y1-y0)).toFixed(1),a=(r()*180).toFixed(0);
    o+='<ellipse cx="'+x+'" cy="'+y+'" rx="'+sz+'" ry="'+(sz*.55).toFixed(1)+'" transform="rotate('+a+' '+x+' '+y+')" class="'+cls+'"/>';
  }
  return o;
}
function sticker(x,y,w,t){
  return '<g><rect x="'+x+'" y="'+y+'" width="'+w+'" height="30" rx="15" class="s-sticker"/><text x="'+(x+w/2)+'" y="'+(y+21)+'" class="s-stxt">'+t+'</text></g>';
}
function svg(body){return '<svg viewBox="0 0 320 240" aria-hidden="true">'+body+'</svg>'}

var CHECK='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
var CROSS='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"/></svg>';
var ARROW='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
var STAR='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2 6.3 20.3l1.2-6.4L2.8 9.5l6.4-.8z" fill="var(--sun)" stroke="#E5A92E" stroke-width="1.6" stroke-linejoin="round"/></svg>';

/* ---------- mascot: こめちゃん ---------- */
function mascot(mood,w){
  var eyes,mouth;
  if(mood==='cheer'){
    eyes='<path d="M29 47q6-9 12 0M51 47q6-9 12 0" fill="none" stroke="#3B3248" stroke-width="3.2" stroke-linecap="round"/>';
    mouth='<path d="M38 55q8 14 16 0z" fill="#FF7A68" stroke="#3B3248" stroke-width="2.4" stroke-linejoin="round"/>';
  }else if(mood==='oops'){
    eyes='<circle cx="35" cy="47" r="3.8" fill="#3B3248"/><circle cx="57" cy="47" r="3.8" fill="#3B3248"/><path d="M28 38q7-5 13-1M64 38q-7-5-13-1" fill="none" stroke="#3B3248" stroke-width="2.6" stroke-linecap="round"/>';
    mouth='<path d="M39 60q3-4 7 0t7 0" fill="none" stroke="#3B3248" stroke-width="2.6" stroke-linecap="round"/>';
  }else{
    eyes='<circle cx="35" cy="47" r="3.8" fill="#3B3248"/><circle cx="57" cy="47" r="3.8" fill="#3B3248"/>';
    mouth='<path d="M40 56q6 7 12 0" fill="none" stroke="#3B3248" stroke-width="2.8" stroke-linecap="round"/>';
  }
  var arms=mood==='cheer'?'<path d="M12 62q-10-6-8-18M80 62q10-6 8-18" fill="none" stroke="#E6D5C8" stroke-width="5" stroke-linecap="round"/>':'';
  return '<svg viewBox="0 0 92 108" width="'+w+'" aria-hidden="true">'+arms+
    '<path d="M46 12C70 12 82 36 82 62C82 88 66 100 46 100C26 100 10 88 10 62C10 36 22 12 46 12Z" fill="#FFFFFF" stroke="#E6D5C8" stroke-width="3.5"/>'+
    '<path d="M46 13q-3-11-13-12q1 10 13 12zM46 13q3-11 13-12q-1 10-13 12z" class="s-leaf"/>'+
    eyes+'<ellipse cx="24" cy="57" rx="7" ry="4.6" fill="#FFB8B0"/><ellipse cx="68" cy="57" rx="7" ry="4.6" fill="#FFB8B0"/>'+mouth+'</svg>';
}

/* ---------- icons for the 作戦シート ---------- */
function flameIco(h){
  return '<svg viewBox="0 0 40 40" aria-hidden="true"><path class="s-flame1 s-outline" d="M12 36C12 '+(36-h*.6)+' 18 '+(36-h*.7)+' 20 '+(36-h)+'C22 '+(36-h*.7)+' 28 '+(36-h*.6)+' 28 36Z"/><path class="s-flame2" d="M16 36C16 '+(36-h*.3)+' 19 '+(36-h*.4)+' 20 '+(36-h*.55)+'C21 '+(36-h*.4)+' 24 '+(36-h*.3)+' 24 36Z"/></svg>';
}
var ICO={
  soak:'<svg viewBox="0 0 40 40" aria-hidden="true"><path class="s-water s-outline" d="M20 5C27 15 31 21 31 26a11 11 0 0 1-22 0C9 21 13 15 20 5Z"/></svg>',
  f3:flameIco(30),f2:flameIco(21),f1:flameIco(12),
  bowl:'<svg viewBox="0 0 40 40" aria-hidden="true"><path class="s-bowl" d="M5 18H35Q35 34 20 34Q5 34 5 18Z"/><path class="s-cooked s-outline" d="M8 18Q20 5 32 18Z"/></svg>',
  lid:'<svg viewBox="0 0 40 40" aria-hidden="true"><path class="s-glass" d="M5 30Q20 12 35 30Z"/><circle cx="20" cy="17" r="2.6" class="s-pot"/><path class="s-steam" style="stroke-width:3" d="M13 10q-3-3 0-6M27 10q-3-3 0-6"/></svg>'
};

/* ---------- questions: 10 もんだい ----------
   img: 動画の場面の写真 / illu: 写真がないときの仮イラスト
   cap: 正解したあとに写真の下に出る、動画のテロップ（写真に写っていたものは、こたえのヒントにならないよう消してある） */
var IMG={"q1": "data:image/jpeg;base64,", "q2": "data:image/jpeg;base64,", "q3": "data:image/jpeg;base64,", "q4": "data:image/jpeg;base64,", "q5": "data:image/jpeg;base64,", "q6": "data:image/jpeg;base64,", "q7": "data:image/jpeg;base64,", "q8": "data:image/jpeg;base64,", "q9": "data:image/jpeg;base64,", "q10": "data:image/jpeg;base64,", "q11": "data:image/jpeg;base64,"};
var STEPS=[
  {no:1,stage:'はかる',img:IMG.q1,alt:'計量カップに山もりに入れた米を、へらで平らにすり切っているところ',cap:'{計量|けいりょう}カップで 米をはかる',
   q:'計量カップで米をはかるとき、どうするのがいいかな？',
   choices:['ぎゅっとおしこんで入れる','山もりに入れて、へらですり切る','目分量で、ざっくり入れる'],answer:1,
   hint:'毎回、同じ量がはかれる方法を考えてみよう。',
   explain:'山もりにして、すり切ると、いつも同じ量がはかれるよ。1人分は、米80g（100mL）が目安だよ。'},
  {no:2,stage:'あらう',img:IMG.q2,alt:'ボウルの中で、米を手であらっているところ',cap:'米を あらう',
   q:'米をあらうとき、気をつけることはどれかな？',
   choices:['ゴシゴシ、長い時間あらう','あらわないで、そのまま入れる','手早くあらう'],answer:2,
   hint:'米は、あらっている間にも水をすっているよ。',
   explain:'米は、あらっている間にも{吸水|きゅうすい}するよ。だから手早くあらおう。水は3〜4回かえながらあらうよ。'},
  {no:3,stage:'ざる',img:IMG.q3,alt:'あらった米を、ボウルからざるにうつしているところ',cap:'ざるに うつす',
   q:'あらい終わった米は、このあとどうするかな？',
   choices:['ざるにうつして、水を切る','あらった水ごと、鍋に入れる','かわくまで、1時間おく'],answer:0,
   hint:'にごった水は、そのままにしないよ。',
   explain:'ざるにうつして、水を切るよ。そのあと、鍋に入れて水にひたすんだ。'},
  {no:4,stage:'{吸水|きゅうすい}',img:IMG.q4,alt:'鍋の中の水に、米がひたっているところ',cap:'30分いじょう 水にひたす',
   q:'たく前に、米を30分いじょう水につけておくのは、なぜかな？',
   choices:['米が水をすって、やわらかくなるじゅんびのため','米をつめたくするため','米のよごれを全部とるため'],answer:0,
   hint:'米はそのままだと、かたいよね。',
   explain:'米はそのままではかたいよ。水をすわせてから熱を加えると、やわらかいご飯になるんだ。水の量は、米の重さの1.5倍。米80gなら、水は120g（120mL）だよ。（動画は、ガラス鍋ではない鍋だよ）'},
  {no:5,stage:'強火',img:IMG.q5,alt:'ガスコンロに火をつけて、鍋をあたためているところ',cap:'{点火|てんか}（{強火|つよび}）',
   q:'火をつけてから、ふっとうするまでの火かげんは？',
   choices:['強火','中火','弱火'],answer:0,
   hint:'まずは、いきおいよくあたためて、ふっとうさせるよ。',
   explain:'{点火|てんか}して、ふっとうするまでは強火。2〜5分くらいだよ。'},
  {no:6,stage:'中火',img:IMG.q6,alt:'鍋の底に当たっている火が、少し小さくなったところ',cap:'{強火|つよび} → {中火|ちゅうび}',
   q:'鍋から湯気が出てきた！ このあと火はどうする？',
   choices:['そのまま強火','中火にする','火を消す'],answer:1,
   hint:'ふっとうしたあとは、火を少しだけよわめるよ。',
   explain:'湯気が出てきたら、強火から中火にするよ。5〜7分くらいたこう。ふきこぼれにも気をつけてね。'},
  {no:7,stage:'弱火',img:IMG.q7,alt:'鍋の底に、小さな火が当たっているところ',cap:'{中火|ちゅうび} → {弱火|よわび}',
   q:'鍋のふちの水が引いてきたら、火はどうする？',
   choices:['もういちど強火にする','火を消す','弱火にする'],answer:2,
   hint:'水が少なくなると、こげやすくなるよ。',
   explain:'鍋のふちの水が引いてきたら、中火から弱火にするよ。15分くらいたこう。'},
  {no:8,stage:'{消火|しょうか}',img:IMG.q8,alt:'コンロのつまみに手をそえて、火を消そうとしているところ',cap:'{消火|しょうか}',
   q:'弱火で15分くらいたいたら、次はどうする？',
   choices:['ふたを開けて、水を足す','火を消す','もっと強い火にする'],answer:1,
   hint:'ご飯がたけたら、もう火はいらないよ。',
   explain:'火を消して、{蒸|む}らしにうつるよ。鍋は熱いので、なべつかみやふきんで持とうね。'},
  {no:9,stage:'{蒸|む}らす',img:IMG.q9,alt:'ふきんの上にのせた鍋に、ふたをしたまま蒸らしているところ',cap:'{蒸|む}らす',
   q:'火を消したあと、10分ふたを開けないのは、なぜかな？',
   choices:['早くさますため','においをにがすため','ご飯つぶの外がわの水分が、中に入っていくため'],answer:2,
   hint:'ご飯つぶの中と外の水分に、ひみつがあるよ。',
   explain:'ご飯つぶの周りの水分が内がわにうつって、ちょうどよいかたさになるよ。'},
  {no:10,stage:'ふきん',img:IMG.q10,alt:'ふたのまわりに、かわいたふきんをはさんでいるところ',cap:'かわいたふきんを はさむ',
   q:'蒸らすとき、かわいたふきんをはさむのは、なぜかな？',
   choices:['ふたについた水てきを、ふきんがすってくれるため','ふたを重くして、にげないようにするため','鍋を早くひやすため'],answer:0,
   hint:'ふたの内がわには、水てきがついているよ。',
   explain:'ふたの水てきがご飯の上に落ちると、べちゃっとしてしまうよ。かわいたふきんが水てきをすってくれるんだ。'},
  {no:11,stage:'しあげ',img:IMG.q11,alt:'しゃもじで、たけたご飯を軽く混ぜているところ',cap:'しゃもじで 軽く混ぜる',
   q:'蒸らし終わったら、ご飯をどうする？',
   choices:['ぎゅっとおしつけて、平らにする','しゃもじで、軽く混ぜる','そのまま、ふたをして置いておく'],answer:1,
   hint:'ご飯のかたまりを、ほぐしてあげよう。',
   explain:'しゃもじで、ご飯を軽く混ぜよう。全体をほぐすと、ふっくら仕上がるよ。'}
];
var N=STEPS.length;
var ROWS=[
  {name:'じゅんび',time:'{吸水|きゅうすい}30分いじょう',cue:'米80g（100mL）をすり切ってはかる。手早くあらって、ざるにうつす。水120gにひたす。',idx:[0,1,2,3],ico:'soak'},
  {name:'強火',time:'2〜5分くらい',cue:'{点火|てんか}して、ふっとうするまで。',idx:[4],ico:'f3'},
  {name:'中火',time:'5〜7分くらい',cue:'湯気が出てきたら、強火から中火に。',idx:[5],ico:'f2'},
  {name:'弱火',time:'15分くらい',cue:'鍋のふちの水が引いてきたら、弱火に。',idx:[6],ico:'f1'},
  {name:'火を消して{蒸|む}らす',time:'10分くらい',cue:'{消火|しょうか}して、かわいたふきんをはさみ、ふたを開けずに待つ。鍋は、なべつかみで持つ。',idx:[7,8,9],ico:'lid'},
  {name:'しあげ',time:'',cue:'しゃもじで、軽く混ぜる。',idx:[10],ico:'bowl'}
];

/* ---------- state ---------- */
var app=$('#app'),idx=0,finished=false,hist=[],st=null;
var reduced=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
function newState(){return {wrong:0,solved:false,picked:{},msg:null}}

/* ---------- views ---------- */
function track(n){
  var h='<ol class="track" aria-label="しんちょく">';
  for(var k=1;k<=N;k++){
    var cls=k<n?'done':(k===n?'now':'');
    h+='<li class="'+cls+'"><span class="dot">'+(k<n?CHECK:k)+'</span>'+(k<N?'<span class="bar '+(k<n?'done':'')+'"></span>':'')+'</li>';
  }
  return h+'</ol>';
}
function header(n){
  return '<header class="top">'+mascot('happy',60)+'<div><h1>ごはんをたこう！</h1><p class="sub">5年 家庭科「ご飯とみそしる」</p></div><span class="pre">試作版</span></header>'+track(n);
}
var FOOT='<p class="foot">試作版です。写真は授業で見る動画の場面です。校内の授業だけで使い、外には公開しないでください。回答の記録は残しません。</p>';
function fbHTML(){
  if(!st.msg)return '';
  var ok=st.msg.ok;
  return '<div class="fb '+(ok?'ok':'no')+'" role="status">'+mascot(ok?'cheer':'oops',68)+'<div class="say"><strong>'+(ok?'せいかい！':'おしい！')+'</strong>'+rubyfy(st.msg.t)+'</div></div>';
}
function nextBtn(){
  if(!st.solved)return '';
  return '<button class="next" data-act="next" id="nextBtn">'+(idx===N-1?'作戦シートを見る':'つぎのもんだいへ')+ARROW+'</button>';
}
function choicesHTML(s){
  var L=['ア','イ','ウ'],h='<div class="choices">';
  s.choices.forEach(function(c,k){
    var cls=st.picked[k]?(k===s.answer?' good':' bad'):'';
    h+='<button class="choice'+cls+'" data-act="pick" data-k="'+k+'"'+(st.solved||st.picked[k]?' disabled':'')+'><span class="badge">'+L[k]+'</span><span class="ctext">'+rubyfy(c)+'</span><span class="mark">'+(cls===' good'?CHECK:cls===' bad'?CROSS:'')+'</span></button>';
  });
  return h+'</div>';
}
function picHTML(s){
  var cap=st.solved?'<div class="cap'+(st.justSolved?' pop':'')+'">'+rubyfy(s.cap||s.stage)+'</div>':'<div class="cap empty">'+(s.img?'動画の場面':'')+'</div>';
  if(s.img){
    return '<div class="pic"><figure class="polaroid"><img class="shot" src="'+s.img+'" alt="'+s.alt+'" width="960" height="600">'+
      '<figcaption>'+cap+'</figcaption></figure></div>';
  }
  return '';
}
function stepView(){
  var s=STEPS[idx];
  return header(s.no)+'<main class="stage">'+picHTML(s)+'<section>'+
    '<div class="qmeta"><span class="stagechip">'+rubyfy(s.stage)+'</span><span class="qno">もんだい '+s.no+' / '+N+'</span></div>'+
    '<h2 class="q" id="qh" tabindex="-1">'+rubyfy(s.q)+'</h2>'+
    choicesHTML(s)+fbHTML()+nextBtn()+'</section></main>'+FOOT;
}
function resultView(){
  var flags=STEPS.map(function(s,k){return hist[k]&&hist[k].wrong===0});
  var ok=flags.filter(Boolean).length,stars='';
  flags.forEach(function(f){stars+='<span class="'+(f?'':'off')+'">'+STAR+'</span>'});
  var rows=ROWS.map(function(r){
    var good=r.idx.every(function(k){return flags[k]});
    return '<div class="row"><span class="ri">'+ICO[r.ico]+'</span><div><b>'+rubyfy(r.name)+'</b>'+(r.time?'<span class="rt">'+rubyfy(r.time)+'</span>':'')+'<span class="cue">'+rubyfy(r.cue)+'</span></div>'+
      '<span class="tag '+(good?'on':'off')+'">'+(good?'ばっちり':'実習でたしかめよう')+'</span></div>';
  }).join('');
  return header(N+1)+'<main class="stage"><section class="pic hero">'+mascot('cheer',120)+'<h2>ぜんぶ できたね！</h2><p>1回で正解できた問題</p><div class="stars" role="img" aria-label="'+N+'問中'+ok+'問">'+stars+'</div><p><b>'+ok+' / '+N+'</b></p><button class="again" data-act="again">もういちどやる</button></section>'+
    '<section class="sheet"><h3>ごはんをたく 作戦シート</h3><p class="note">実習の日に、この順番で鍋を見ていこう。時間は、4人分をたくときのめやすだよ。</p>'+rows+'</section></main>'+FOOT;
}

/* ---------- actions ---------- */
function render(opt){
  opt=opt||{};
  app.innerHTML=finished?resultView():stepView();
  if(opt.focusHead){var h=$('#qh');if(h)h.focus({preventScroll:true})}
  if(opt.scrollFb){var f=$('.fb');if(f)f.scrollIntoView({block:'nearest',behavior:reduced?'auto':'smooth'})}
  if(st)st.justSolved=false;
}
function pick(k){
  var s=STEPS[idx];
  if(st.solved||st.picked[k])return;
  st.picked[k]=true;
  if(k===s.answer){st.solved=true;st.justSolved=true;st.msg={ok:true,t:s.explain};hist[idx]=st}
  else{st.wrong++;st.msg={ok:false,t:s.hint}}
  render({scrollFb:true});
}
function next(){
  if(idx===N-1){finished=true;render();window.scrollTo(0,0);return}
  idx++;st=newState();render({focusHead:true});window.scrollTo(0,0);
}
function restart(){idx=0;finished=false;hist=[];st=newState();render({focusHead:true});window.scrollTo(0,0)}
app.addEventListener('click',function(e){
  var b=e.target.closest('[data-act]');
  if(!b||b.disabled)return;
  var a=b.dataset.act;
  if(a==='pick')pick(+b.dataset.k);
  else if(a==='next')next();
  else if(a==='again')restart();
});
st=newState();render();
</script>
